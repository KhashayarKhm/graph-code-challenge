# Deployment mode: "development", "production" or "test".
APP_MODE=development
HTTP_PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/task_manager?sslmode=disable
# Leave REDIS_URL empty to run without the cache-aside layer.
REDIS_URL=redis://localhost:6379/0
REDIS_TTL=60s
# Disabled by default. When enabled, pprof uses a separate internal listener.
PPROF_ENABLED=false
PPROF_PORT=6060
